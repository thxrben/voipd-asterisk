# Copy to .env and set strong random values (e.g. `openssl rand -hex 24`).
VOIPD_ARI_PASSWORD=change-me
VOIPD_AMI_PASSWORD=change-me
# Local area code without leading 0, for numbers dialed without one.
VOIPD_AREA_CODE=201

# Web UI. voipd listens on all addresses (host networking); put it behind a
# reverse proxy for HTTPS and set the public URL users open.
VOIPD_HTTP_LISTEN=[::]:8080
VOIPD_PUBLIC_URL=https://voip.example.com

# Login via authentik (OIDC provider, confidential client, redirect URI
# <public url>/auth/callback). Group membership decides the role.
VOIPD_OIDC_ISSUER=https://auth.example.com/application/o/voipd/
VOIPD_OIDC_CLIENT_ID=voipd
VOIPD_OIDC_CLIENT_SECRET=change-me
#VOIPD_ADMIN_GROUP=voipd-admins
#VOIPD_USER_GROUP=voipd-users

# Optional break-glass local login "admin" (works without authentik).
# Create with: docker compose run --rm voipd hash-password
#VOIPD_ADMIN_PASSWORD_HASH=$argon2id$v=19$...
